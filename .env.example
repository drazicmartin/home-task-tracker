# Copy this file to .env and fill in real values before running
# `docker compose up -d`. On Coolify, set these as the stack's
# environment variables instead of using a .env file.

# Public URL this app will be served at (used by SvelteKit for CSRF checks).
# Must match the domain you point at the "sk" service.
ORIGIN=https://your-domain.example.com

# PocketBase superuser account, auto-created on first boot (pb/docker-entrypoint.sh).
# Used server-side only (never sent to the browser) for the handful of
# privileged writes — creating a household and its first membership — that
# regular users intentionally can't do directly. Use a real password.
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=change-me-to-a-strong-password
