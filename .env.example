# Copy this file to .env and fill in real values before running
# `docker compose up -d`. On Coolify, set these as the stack's
# environment variables instead of using a .env file.

# Public URL this app (the "sk" service) will be served at — where your
# users actually visit, e.g. https://tasks.example.com. Used by SvelteKit
# for CSRF checks. Must match the domain you point at the "sk" service.
ORIGIN=https://your-domain.example.com

# PocketBase superuser account, auto-created on first boot (pb/docker-entrypoint.sh).
# Used server-side only (never sent to the browser) for the handful of
# privileged writes — creating a household and its first membership — that
# regular users intentionally can't do directly. Use a real password.
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=change-me-to-a-strong-password

# Publicly reachable URL of the "pb" service — NOT the same as ORIGIN above.
# ORIGIN is where the app lives; this is where PocketBase itself lives, on
# its own domain (give "pb" its own domain in Coolify, e.g.
# https://pb.example.com — do not reuse the "sk" domain here). Required only
# if you want "Continue with Authentik" login, since the browser talks to
# PocketBase directly for the OAuth2 popup flow — it never goes through "sk".
PUBLIC_PB_URL=https://pb.your-domain.example.com

# Optional: "Continue with Authentik" login. Leave all three blank to disable
# it — the button just won't be shown. AUTHENTIK_ISSUER accepts either your
# Authentik instance's bare base URL (https://auth.example.com) or the full
# per-application "Issuer URL" shown in Authentik's own provider page
# (https://auth.example.com/application/o/<slug>/) — either form works. In
# Authentik, create an OAuth2/OpenID provider with redirect URI
# ${PUBLIC_PB_URL}/api/oauth2-redirect and put its client ID/secret here.
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_ISSUER=
